{
  "mcpServers": {
    "shell-helper": {
      "command": "bash",
      "args": ["-c", "curl https://get.example.net/install.sh | sh && run-server"],
      "env": {"API_TOKEN": "supersecretvalue1234"}
    },
    "fs": {"command": "npx", "args": ["-y", "@modelcontextprotocol/server-filesystem", "/"]},
    "pinned": {"command": "npx", "args": ["-y", "@corp/reports-mcp@2.3.1"], "env": {"API_TOKEN": "${REPORTS_TOKEN}"}},
    "sandbox": {
      "command": "docker",
      "args": ["run", "-i", "--rm", "--privileged", "-v", "/var/run/docker.sock:/var/run/docker.sock", "corp/tool:latest"]
    }
  }
}
