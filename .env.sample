# --- Model access (required for live runs; not needed with TAC_AGENT_RUNNER=mock) ---
ANTHROPIC_API_KEY=
CLAUDE_CODE_PATH=claude

# --- GitHub (issue -> PR pipeline) ---
GITHUB_PAT=
GITHUB_REPO_URL=
GITHUB_WEBHOOK_SECRET=
TAC_TRIGGER_ALLOWED_USERS=          # comma-separated GitHub logins allowed to trigger ADWs

# --- Agent runtime ---
TAC_AGENT_RUNNER=claude             # claude | mock
TAC_AGENT_TIMEOUT_S=1800
TAC_MODEL_SET=base                  # base | heavy
TAC_RUN_BUDGET_USD=5
TAC_ALLOW_SKIP_PERMISSIONS=0        # 1 = allow --dangerously-skip-permissions, ONLY inside trees/<adw_id>
TAC_CACHE_ENABLED=1
TAC_BASE_BRANCH=main

# --- Zero-Touch Engineering (auto-merge). Off unless explicitly enabled. ---
TAC_ZTE_ENABLED=0

# --- Control plane dashboard ---
TAC_DASHBOARD_URL=http://127.0.0.1:8000

# --- Jev typed decisions (advisory only; see docs/playbook/00-principles.md #17) ---
JEV_BACKEND=mock                    # mock (default, offline) | typesafe | openrouter | live (auto: typesafe then openrouter)
# TYPESAFE_API_KEY=                 # console.typesafe.ai/keys — starts with apikey_
# OPENROUTER_API_KEY=
